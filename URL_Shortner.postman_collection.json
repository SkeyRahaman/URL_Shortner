{
	"info": {
		"name": "URL Shortener Microservice API",
		"description": "Full API workflow to test the modernized stateless URL shortener.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"health"
					]
				}
			}
		},
		{
			"name": "Metrics",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/metrics",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"metrics"
					]
				}
			}
		},
		{
			"name": "Create Link (Auto-slug)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData && jsonData.slug) {",
							"    pm.collectionVariables.set(\"slug\", jsonData.slug);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"original_url\": \"https://github.com/\",\n    \"description\": \"My GitHub link\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/links",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links"
					]
				}
			}
		},
		{
			"name": "Create Link (Custom Alias)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData && jsonData.slug) {",
							"    pm.collectionVariables.set(\"custom_slug\", jsonData.slug);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"original_url\": \"https://google.com/\",\n    \"description\": \"Custom Google Link\",\n    \"custom_slug\": \"my-google-link-{{$randomAlphaNumeric}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/links",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links"
					]
				}
			}
		},
		{
			"name": "List User Links",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/links",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links"
					]
				}
			}
		},
		{
			"name": "Get Link Details",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/links/{{slug}}/details",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links",
						"{{slug}}",
						"details"
					]
				}
			}
		},
		{
			"name": "Redirect Link",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/links/{{slug}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links",
						"{{slug}}"
					]
				}
			}
		},
		{
			"name": "Update Link",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"description\": \"Updated description\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/links/{{slug}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links",
						"{{slug}}"
					]
				}
			}
		},
		{
			"name": "Deactivate Link",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/links/{{slug}}/deactivate",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links",
						"{{slug}}",
						"deactivate"
					]
				}
			}
		},
		{
			"name": "Delete Link",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/links/{{slug}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links",
						"{{slug}}"
					]
				}
			}
		},
		{
			"name": "Delete Custom Link",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "X-User-Id",
						"value": "1",
						"type": "text"
					}
				],
				"url": {
					"raw": "{{base_url}}/links/{{custom_slug}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"links",
						"{{custom_slug}}"
					]
				}
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080"
		},
		{
			"key": "slug",
			"value": ""
		},
		{
			"key": "custom_slug",
			"value": ""
		}
	]
}